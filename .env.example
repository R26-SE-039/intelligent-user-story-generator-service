# App
APP_ENV=dev

# LLM Provider (OpenAI or OpenRouter)
LLM_API_KEY=
LLM_API_BASE=https://openrouter.ai/api/v1
CHAT_MODEL=meta-llama/llama-3.1-70b-instruct
EMBEDDING_MODEL=text-embedding-3-small

# Chroma vector DB
CHROMA_PERSIST_DIRECTORY=data/vector_index/chroma
VECTOR_DB_COLLECTION=transcript_chunks

# Pipeline defaults
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=8

# Azure Speech Service credentials
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Auth secret for custom JWT verification (must match auth-service)
AUTH_SECRET=dev-change-me-secret

# Speech transcription tuning
TRANSCRIPTION_TIMEOUT_SECONDS=120
TRANSCRIPTION_POLL_INTERVAL_SECONDS=1.2

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agile_meeting_db

DB_TRANSCRIPTS_TABLE=transcripts
DB_UTTERANCES_TABLE=transcript_utterances
DB_CHUNKS_TABLE=transcript_chunks
DB_STORY_RUNS_TABLE=story_runs
DB_STORIES_TABLE=user_stories
DB_SPEECH_SESSIONS_TABLE=speech_sessions
DB_CAPTIONS_TABLE=speech_captions
DB_MEETINGS_TABLE=meetings
DB_CHATS_TABLE=meeting_chat_messages
