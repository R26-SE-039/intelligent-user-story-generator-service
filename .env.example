# App
APP_ENV=dev

# LLM Provider (OpenAI or OpenRouter)
LLM_API_KEY=
LLM_API_BASE=https://openrouter.ai/api/v1
CHAT_MODEL=meta-llama/llama-3.1-70b-instruct
EMBEDDING_MODEL=text-embedding-3-small

# Chroma vector DB
CHROMA_PERSIST_DIRECTORY=data/vector_index/chroma
VECTOR_DB_COLLECTION=transcript_chunks

# Pipeline defaults
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=8

# Azure Speech Service credentials
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Auth secret for custom JWT verification (must match auth-service)
AUTH_SECRET=dev-change-me-secret

# Speech transcription tuning
TRANSCRIPTION_TIMEOUT_SECONDS=120
TRANSCRIPTION_POLL_INTERVAL_SECONDS=1.2

# Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=nextgen_rag_service
SUPABASE_SPEECH_SCHEMA=nextgen_speech_service
SUPABASE_TRANSCRIPTS_TABLE=transcripts
SUPABASE_UTTERANCES_TABLE=transcript_utterances
SUPABASE_CHUNKS_TABLE=transcript_chunks
SUPABASE_STORY_RUNS_TABLE=story_runs
SUPABASE_STORIES_TABLE=generated_stories
SUPABASE_SPEECH_SESSIONS_TABLE=speech_sessions
SUPABASE_CAPTIONS_TABLE=speech_captions
SUPABASE_MEETINGS_TABLE=meetings
SUPABASE_CHATS_TABLE=meeting_chats
