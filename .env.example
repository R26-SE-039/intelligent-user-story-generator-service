# App
APP_ENV=dev

# LLM Provider (OpenAI or OpenRouter)
LLM_API_KEY=
LLM_API_BASE=https://openrouter.ai/api/v1
CHAT_MODEL=meta-llama/llama-3.1-70b-instruct
EMBEDDING_MODEL=text-embedding-3-small

# Chroma vector DB
CHROMA_PERSIST_DIRECTORY=data/vector_index/chroma
VECTOR_DB_COLLECTION=transcript_chunks

# Pipeline defaults
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=8

# Azure Speech Service credentials
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Auth secret for custom JWT verification (must match auth-service)
AUTH_SECRET=dev-change-me-secret

# Speech transcription tuning
TRANSCRIPTION_TIMEOUT_SECONDS=120
TRANSCRIPTION_POLL_INTERVAL_SECONDS=1.2

# PostgreSQL (Neon Cloud)
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://<user>:<password>@<host>/meeting_db?sslmode=require&channel_binding=require

DB_HOST=<neon-host>
DB_PORT=5432
DB_USER=<neon-user>
DB_PASSWORD=<neon-password>
DB_NAME=meeting_db
DB_SSLMODE=require

# Table names
DB_MEETINGS_TABLE=meetings
DB_CHAT_MESSAGES_TABLE=chat_messages
DB_TRANSCRIPTS_TABLE=transcripts
DB_TRANSCRIPT_UTTERANCES_TABLE=transcript_utterances
DB_REQUIREMENTS_TABLE=requirements
DB_REQUIREMENT_EMBEDDINGS_TABLE=requirement_embeddings
DB_REQUIREMENT_UTTERANCE_MAPPING_TABLE=requirement_utterance_mapping
DB_CONFLICTS_TABLE=conflicts
DB_USER_STORIES_TABLE=user_stories
DB_USER_STORY_REQUIREMENT_MAPPING_TABLE=user_story_requirement_mapping
DB_ACCEPTANCE_CRITERIA_TABLE=acceptance_criteria
